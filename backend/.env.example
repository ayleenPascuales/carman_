# Instancia TiDB Cloud compatible con MySQL (NO PostgreSQL).
# Copiar host/puerto/usuario/base de Connect -> General/MySQL. Usar contraseña ROTADA.
DB_HOST=tu-host.tidbcloud.com
DB_PORT=4000
DB_USER=tu_prefijo.root
DB_PASSWORD=tu_nueva_password
DB_NAME=tu_base
DB_POOL_SIZE=2
# En local: verifica TLS con el certificado público incluido en este repositorio.
DB_SSL_CA_PATH=certs/isrgrootx1.pem
# En Vercel: NO establecer DB_SSL_CA_PATH; pegar el contenido PEM en DB_SSL_CA.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Configuración del MISMO proyecto de Firebase Authentication (habilitar Email/Password).
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_API_KEY=tu-web-api-key
# Opción recomendada para Vercel: credenciales del servicio en variables secretas.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa: FIREBASE_SERVICE_ACCOUNT_JSON (JSON completo) en lugar de las dos anteriores.
# Alternativa local: GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/serviceAccountKey.json

# textbee: un Android propio online con SIM y cuota SMS de tu operador.
# Crear API key desde el dashboard de textbee; mantenerla SOLO en backend.
TEXTBEE_API_KEY=reemplazar_por_clave_privada
# Clave HMAC propia e independiente de Firebase, generar con: openssl rand -hex 32
# NO copiar el comando ni este marcador como valor real.
SMS_OTP_SECRET=reemplazar_por_64_caracteres_hexadecimales

# En local, sin CORS_ORIGINS se acepta localhost en cualquier puerto.
# En Vercel es obligatorio: dominios exactos Flutter Web, sin / final.
# CORS_ORIGINS=https://tu-frontend.vercel.app
# Solo requerido en Vercel: Vercel Schedules envía Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=reemplazar-por-un-secreto-largo-aleatorio
